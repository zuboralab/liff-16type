<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>16タイプ診断</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>
</head>
<body>

<p id="status">起動中です…</p>

<script>
async function main() {
  const status = document.getElementById("status");

  try {
    status.textContent = "LIFF初期化中…";
    await liff.init({ liffId: "2008801940-ObLOZHyA" });

    if (!liff.isLoggedIn()) {
      liff.login();
      return;
    }

    status.textContent = "ユーザー確認中…";
    const profile = await liff.getProfile();
    const userId = profile.userId;

    const formUrl =
      "https://docs.google.com/forms/d/e/1FAIpQLSdPMYVJGOKXUSjfsDbZzydYn8hArBIH7mGZ0uNGrda-3mit2A/viewform"
      + "?entry.1832876883=" + encodeURIComponent(userId);

    status.textContent = "アンケートに移動します…";

    liff.openWindow({
      url: formUrl,
      external: true
    });

    setTimeout(() => {
      liff.closeWindow();
    }, 500);

  } catch (err) {
    status.textContent = "エラーが発生しました";
    console.error(err);
  }
}

main();
</script>

</body>
</html>
